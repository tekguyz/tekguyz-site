    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "geist": "^1.6.1",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
