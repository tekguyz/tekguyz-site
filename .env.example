# TEKGUYZ site — environment variables.
# Copy to .env.local for development; set the same keys in Vercel for production.
# NONE of these may be prefixed NEXT_PUBLIC_ — every one is server-only.

# Resend — delivers the internal notification and the submitter confirmation email.
RESEND_API_KEY=

# CRM triage webhook. Full URL, ending in the ORGANIZATION ID — not a secret:
#   https://tekguyz-crm.vercel.app/api/v1/triage/[organization_id]
# Copy it from the CRM's Settings -> Organization panel ("Endpoint URL").
CRM_TRIAGE_ENDPOINT=

# CRM request signing key (2026-08-18). THIS is the credential — the URL above
# is not. Every POST to the triage endpoint carries an X-TekGuyz-Signature
# header holding the hex HMAC-SHA256 of the exact request body, keyed by this
# value. Without it the CRM returns 401 and the lead is archived as a failure.
# Copy it from the same CRM panel ("Signing secret"). Rotating it there takes
# effect immediately, with no grace period — update this first, then rotate.
# CORS is NOT involved in this call: it is a server-side fetch from a Server
# Action, so there is no origin and no preflight. The CRM's allowed-origin list
# has never applied to it.
CRM_SIGNING_SECRET=

# Gemini — AI concierge. Server-side only.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Durable rate limiter (Vercel KV or Upstash Redis). Either naming works.
# Without these the limiter falls back to a per-instance in-memory bucket,
# which resets on cold start and is NOT real protection in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
